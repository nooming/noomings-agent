DEEPSEEK_API_KEY=

DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# HTMLGen 微调模型（fine-tune 完成后填入；batch-html-dataset 生成 HTML 时使用）
# FINETUNED_MODEL_ID=ft:deepseek-chat:org:htmlgen-v1:abc123
# HTMLGEN_MODEL=deepseek-chat
# FINETUNE_BASE_MODEL=deepseek-chat

# 本地默认 3001；Zeabur 等平台会注入 PORT，服务会优先使用 PORT
AGENT_PORT=3001

# 教师工作台通行码（Phase 1 共享口令；Zeabur 在 Variables 中设置同名环境变量）
# 未配置时：登录接口拒绝；写接口在开发态放行（无码时不做 Bearer 校验）
# 生产（NODE_ENV=production / PaaS / PLATFORM_REQUIRE_TEACHER_CODE=1）无码则学情/教师 API 503
TEACHER_ACCESS_CODE=
# 兼容别名（二者任一即可）：PLATFORM_TEACHER_PASS=
# TEACHER_TOKEN_TTL_MS=28800000
# TEACHER_LOGIN_MAX_FAILS=8
# TEACHER_LOGIN_LOCK_MS=900000
# PLATFORM_REQUIRE_TEACHER_CODE=1
# PLATFORM_PUBLISH_STRICT=1

# Agent A 草稿输出（默认 data/output/，相对本 agent 目录；旧 output/ 仍可读）
# AGENT_OUTPUT_ROOT=data/output

# 图谱预览 viewer 根（须含 graph.html、js/viewer.js）；默认 frontend/viewer/
# AGENT_VIEWER_ROOT=frontend/viewer

# 已弃用（仍可读）：STATIC_GAME_ROOT → 请改用 AGENT_VIEWER_ROOT
