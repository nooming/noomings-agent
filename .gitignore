.env
node_modules/
*.log
resources/*cookies*.txt
resources/_probe*
resources/_*.js
resources/_*.html
resources/_*.json
data/runtime/output/**
!data/runtime/output/.gitkeep
# 迁服临时入库已结束，恢复忽略课堂轨迹
data/runtime/platform/traces/*
!data/runtime/platform/traces/.gitignore
# 课堂码运行时配置（可含演示用码；生产码用环境变量）
data/runtime/platform/class-config.json
# PCA/分析快照（大 JSON）；目录占位见 data/runtime/analysis/.gitignore
data/runtime/analysis/traces-全部-*/
# 禁止根目录长期留 traces 快照包
/traces-全部-*/
data/output/design-runs/
data/platform/traces/
_archive/
临时/
